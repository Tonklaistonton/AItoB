{
  "name": "aitob-submission",
  "services": {
    "gmail": {
      "image": "aitob-gmail-lab:day2",
      "pull_policy": "never",
      "restart": "unless-stopped",
      "user": "10001:10001",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=64m",
        "/run:rw,noexec,nosuid,size=16m"
      ],
      "ports": [
        "127.0.0.1:8001:8001"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${AITOB_LAB_ROOT}/gmail-lab",
          "target": "/app",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${AITOB_LAB_ROOT}/gmail-lab/credentials",
          "target": "/app/credentials",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${AITOB_LAB_ROOT}/gateway",
          "target": "/gateway",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "1.0",
            "memory": "1024M",
            "pids": 100
          },
          "reservations": {
            "cpus": "0.2",
            "memory": "256M"
          }
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health')"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "command": [
        "python",
        "-u",
        "/app/gmail_backend.py"
      ],
      "working_dir": "/app",
      "environment": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "assistant": {
      "image": "aitob-mcp-lab:day2",
      "pull_policy": "never",
      "restart": "unless-stopped",
      "user": "10001:10001",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=128m",
        "/run:rw,noexec,nosuid,size=16m"
      ],
      "ports": [
        "127.0.0.1:8002:8002"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${AITOB_LAB_ROOT}/mcp-lab",
          "target": "/app",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${AITOB_LAB_ROOT}/gateway",
          "target": "/gateway",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${AITOB_LAB_ROOT}/gateway/runtime/finance",
          "target": "/gateway/runtime/finance",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "deploy": {
        "resources": {
          "limits": {
            "cpus": "2.0",
            "memory": "2048M",
            "pids": 150
          },
          "reservations": {
            "cpus": "0.5",
            "memory": "512M"
          }
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health')"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "10s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "command": [
        "python",
        "-u",
        "/app/aitob_assistant_service.py"
      ],
      "working_dir": "/app",
      "environment": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
