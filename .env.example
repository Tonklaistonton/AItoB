# Ports
OPENWEBUI_PORT=3000
GATEWAY_PORT=8000
GMAIL_PORT=8001
ASSISTANT_PORT=8002

# LLM Provider: 'ollama' | 'openai' | 'anthropic'
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:12b

# Cloud APIs (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security
WEBUI_SECRET_KEY=change_this_to_a_random_secret_in_production
WEBUI_AUTH=true
